      <file file_name="$(SDK_DIR)/modules/nrfx/drivers/src/nrfx_uart.c" />
      <file file_name="$(SDK_DIR)/modules/nrfx/drivers/src/nrfx_uarte.c" />
      <file file_name="$(SDK_DIR)/integration/nrfx/legacy/nrf_drv_spis.c" />
      <file file_name="$(SDK_DIR)/modules/nrfx/drivers/src/nrfx_spis.c" />
    </folder>
    <folder Name="Application">
      <file file_name="../../../main.c" />
      <file file_name="../../../app/app_ble_adv.c" />
      <file file_name="../../../app/app_ble_nus.c" />
      <file file_name="../../../app/app_ble_pm.c" />
      <file file_name="../../../app/app_ble.c" />
      <file file_name="../../../app/app_sp_spis.c" />
      <file file_name="../../../app/app_sp_uart.c" />
      <file file_name="../../../app/app_sp.c" />
      <folder Name="Config">
        <file file_name="../config/app_config.h" />
        <file file_name="../config/sdk_config.h" />
      </folder>
      <folder Name="Unity Test">
        <file file_name="../../../app/test/test_app_ble.c" />
        <file file_name="../../../app/test/test_app.c" />
        <file file_name="../../../app/test/test_app_sp.c" />
        <file file_name="../../../app/test/test_app_cmd.c" />
